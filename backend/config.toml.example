# ─────────────────────────────────────────────────────────────────────
# SpiritAgent 后端启动基准配置文件 (config.toml.example)
#
# 【重要设计说明】
# 本文件仅保留影响后端冷启动运行的必要参数（数据库连接、密钥、初始管理员凭据、数据存储等）。
# 所有业务型参数（如 AI 供应商凭据、模型名称、图生 3D、超时重试、接口限流、渠道接入等）
# 均已收敛至后台管理页面（/admin/）动态配置，并在保存时实时持久化至数据库且热生效，无需重启容器！
#
# 使用方法：
# 复制本文件为 `config.toml` 并按实际环境修改；`config.toml` 已被 Git 忽略。
# 配置优先级：系统环境变量 > .env > config.toml > config.toml.example
# ─────────────────────────────────────────────────────────────────────

[runtime]
# 后端服务名称（用于日志、文档及 OpenAPI 标识）
app_name = "SpiritAgent Backend"
# 统一 API 路由前缀
api_prefix = "/api"

[database]
# 数据库连接 URL（SQLAlchemy 格式）。在 Docker Compose 环境中服务名为 postgres（端口 5432）
database_url = "postgresql+psycopg://postgres:postgres@postgres:5432/spiritagent"

[auth]
# JWT 签名私钥（生产环境必须修改为随机强密钥，长度需 ≥ 16 个字符）
jwt_secret_key = "replace-this-with-a-strong-secret"
# JWT 签名算法
jwt_algorithm = "HS256"
# 伴侣头像与 3D 资产 URL 的 HMAC 签名密钥（生产环境必须配置，防止未授权访问）
companion_asset_signing_key = "replace-this-with-a-companion-asset-signing-key"
# 初始超级管理员用户名（首次冷启动时自动创建）
admin_username = "spiritagent"
# 初始超级管理员密码（首次冷启动时自动创建）
admin_password = "spiritagent@admin123"

[storage]
# 后端磁盘数据与产物存储根目录（支持相对或绝对路径）
data_dir = "./data"

[rate_limit]
# 速率限制器后端存储 URL（为空时默认使用进程内内存存储；生产高可用可配置 redis://...）
rate_limit_storage_url = ""

[observability]
# 是否开启 Prometheus 指标端点（冷启动挂载）
metrics_enabled = true
# 指标采集暴露路径
metrics_path = "/metrics"
