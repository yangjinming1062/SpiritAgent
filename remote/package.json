{
  "name": "spiritagent-remote",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": "11.5.2"
  },
  "description": "唤生手机远程页面",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint . --fix && prettier --config .prettierrc --write \"*.{ts,tsx,css,html,mjs,json}\" ../shared/protocol.ts && tsc --noEmit"
  },
  "dependencies": {
    "@tabler/icons-react": "3.44.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/eslint-plugin": "8.61.1",
    "@typescript-eslint/parser": "8.61.1",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-perfectionist": "5.9.1",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "16.5.0",
    "prettier": "3.8.4",
    "typescript": "6.0.3",
    "vite": "8.0.16"
  }
}
